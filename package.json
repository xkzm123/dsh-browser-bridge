{
  "name": "dsh-browser-bridge",
  "version": "1.5.0",
  "description": "Operate the Edge or Chrome window that is already open, without restarting it: read the page, click elements by accessible name, type text, scroll, screenshot, and run JavaScript through a userscript bridge. Batch many commands in one process (17x faster), verify state with a single pixel instead of a screenshot. Windows only; drives the live window over UI Automation and SendInput.",
  "license": "MIT",
  "author": "xkzm123",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "assets",
    "lib",
    "scripts",
    "bridge",
    "references",
    "SKILL.md",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "browser-automation",
    "ui-automation",
    "sendinput",
    "userscript",
    "edge",
    "chrome",
    "windows",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkzm123/dsh-browser-bridge.git"
  },
  "homepage": "https://github.com/xkzm123/dsh-browser-bridge#readme",
  "bugs": {
    "url": "https://github.com/xkzm123/dsh-browser-bridge/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
